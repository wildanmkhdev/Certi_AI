# Hugging Face AI (Fallback provider — used only when Gemini fails)
# Server-side only. Never expose with NEXT_PUBLIC_ prefix.
HF_TOKEN=
HF_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct

# Optional: override Hugging Face endpoint.
# Default (classic Inference API): https://api-inference.huggingface.co
# Alternative (Inference Providers router): https://router.huggingface.co/v1
# HF_BASE_URL=https://api-inference.huggingface.co